# Iron Bike Co-Pilot — Variables d'environnement requises
# Copier ce fichier en .env.local et renseigner les valeurs

# Clé API Anthropic — obtenir sur console.anthropic.com
ANTHROPIC_API_KEY=

# Mot de passe de la démo — partagé avec les participants
DEMO_PASSWORD=

# Secret de signature du cookie de session — chaîne aléatoire d'au moins 32 caractères
DEMO_COOKIE_SECRET=

# Optionnel en local (les 3 variables ci-dessus suffisent si data/participants.csv existe).
# Auto-provisionnée par Vercel quand le store Blob est lié au projet — utilisée en prod comme
# fallback pour lire les données quand data/ n'existe pas dans le déploiement.
# Voir docs/DEPLOYMENT.md.
BLOB_READ_WRITE_TOKEN=
